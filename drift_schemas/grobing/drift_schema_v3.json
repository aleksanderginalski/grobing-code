  "fixed_sql": [
    {
      "name": "persons",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"persons\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"given_names\" TEXT NULL, \"surname\" TEXT NULL, \"birth_surname\" TEXT NULL, \"bio\" TEXT NULL, \"bio_source\" TEXT NULL, \"is_living\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_living\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "families",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"families\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT);"
        }
      ]
    },
    {
      "name": "family_partners",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"family_partners\" (\"family_id\" INTEGER NOT NULL REFERENCES families (id), \"person_id\" INTEGER NOT NULL REFERENCES persons (id), PRIMARY KEY (\"family_id\", \"person_id\"));"
        }
      ]
    },
    {
      "name": "family_children",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"family_children\" (\"family_id\" INTEGER NOT NULL REFERENCES families (id), \"person_id\" INTEGER NOT NULL REFERENCES persons (id), PRIMARY KEY (\"family_id\", \"person_id\"));"
        }
      ]
    },
    {
      "name": "events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"events\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"type\" TEXT NOT NULL, \"person_id\" INTEGER NULL REFERENCES persons (id), \"family_id\" INTEGER NULL REFERENCES families (id), \"qualifier\" TEXT NULL, \"year\" INTEGER NULL, \"month\" INTEGER NULL, \"day\" INTEGER NULL, \"year_to\" INTEGER NULL, \"month_to\" INTEGER NULL, \"day_to\" INTEGER NULL, \"place\" TEXT NULL, CHECK ((person_id IS NULL) <> (family_id IS NULL)), CHECK ((type IN ('birth', 'death', 'burial')) = (person_id IS NOT NULL)));"
        }
      ]
    },
    {
      "name": "cemeteries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"cemeteries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"locality\" TEXT NULL, \"center_lat\" REAL NULL, \"center_lon\" REAL NULL, \"grobonet_url\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "graves",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"graves\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"cemetery_id\" INTEGER NOT NULL REFERENCES cemeteries (id), \"name\" TEXT NULL, \"sector\" TEXT NULL, \"row\" TEXT NULL, \"plot\" TEXT NULL, \"lat\" REAL NULL, \"lon\" REAL NULL, \"position_source\" TEXT NULL, \"position_accuracy_m\" REAL NULL);"
        }
      ]
    },
    {
      "name": "burials",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"burials\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"person_id\" INTEGER NOT NULL REFERENCES persons (id), \"grave_id\" INTEGER NOT NULL REFERENCES graves (id), UNIQUE (\"person_id\", \"grave_id\"));"
        }
      ]
    },
    {
      "name": "assertions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"assertions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"event_id\" INTEGER NULL REFERENCES events (id), \"burial_id\" INTEGER NULL REFERENCES burials (id), \"source_kind\" TEXT NOT NULL, \"source_detail\" TEXT NULL, \"status\" TEXT NOT NULL, \"recorded_at\" INTEGER NOT NULL, CHECK ((event_id IS NULL) <> (burial_id IS NULL)));"
        }
      ]
    },
    {
      "name": "media",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"media\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"relative_path\" TEXT NOT NULL UNIQUE, \"person_id\" INTEGER NULL REFERENCES persons (id), \"grave_id\" INTEGER NULL REFERENCES graves (id), CHECK ((person_id IS NULL) <> (grave_id IS NULL)));"
        }
