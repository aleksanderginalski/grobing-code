# --- Family data: NEVER in any Grobing repo (grobing-agents/.claude/rules/family-data.md) ---
# The same block in all three repos (ISSUE-006). The PreToolUse guard in grobing-agents
# (.claude/hooks/family-data-guard.ps1) refuses the same list for Claude; this file is what
# protects the author's own commits. By file type and root folder, not by content.
# Test fixtures use invented people only.
# Databases
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-*
# Backup and export (ADR-004): an age file with a tar inside; the export is HTML + PDF
*.age
*.tar
*.html
*.pdf
# Photos and videos
*.jpg
*.jpeg
*.png
*.heic
*.heif
*.webp
*.gif
*.bmp
*.tif
*.tiff
*.dng
*.mp4
*.mov
# Real-data folders, anchored to the repo root (unanchored `backups/` would also hide code
# such as lib/features/backups/)
/exports/
/backups/
/family-data/
/real-data/
# The only exception in this repo: UI images in Android resources (launcher icons). One line per
# image type, never the whole folder -- `!/android/app/src/main/res/**` would re-include *.db there.
!/android/app/src/main/res/**/*.png
!/android/app/src/main/res/**/*.jpg
!/android/app/src/main/res/**/*.jpeg
!/android/app/src/main/res/**/*.gif
!/android/app/src/main/res/**/*.webp

# --- Secrets: never in the repo (hard floor, PROJECT_BRIEF §Security) ---
*.jks
*.keystore
key.properties
local.properties
**/google-services.json

# --- Flutter / Android build output ---
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies

# --- Flutter defaults (`flutter create`, 3.41.1), merged below the blocks above (ISSUE-002) ---
# Duplicates of the entries above are dropped; `build/` above already covers `/build/`.

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.pub-cache/
.pub/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
